# ==============================================================================
# Agent Harness & Workflow Automation Signal Radar - Runtime Configuration
# Copy this file to .env and populate values via Secret Manager or local env.
# NEVER commit real API keys or tokens to version control.
# ==============================================================================

# --- Model Backend Configuration ---
# Google AI Studio mode (local development):
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
# Or Vertex AI mode (cloud / production):
# GOOGLE_GENAI_USE_ENTERPRISE=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Strategic model routing tiers
REASONING_MODEL=gemini-2.5-pro
FAST_MODEL=gemini-2.5-flash

# --- Secret Manager Integration ---
# Set USE_SECRET_MANAGER=true in Cloud Run / Agent Engine deployments
USE_SECRET_MANAGER=false
GEMINI_API_KEY_SECRET_ID=gemini-api-key
GITHUB_TOKEN_SECRET_ID=github-pat-token
WEBHOOK_URL_SECRET_ID=digest-webhook-url
SECRET_VERSION=latest

# Local dev overrides (leave empty in repository; inject at runtime only)
GOOGLE_API_KEY=
GITHUB_TOKEN=
DIGEST_WEBHOOK_URL=

# --- Persistent Session, Memory & Vector Databases ---
SESSION_DB_URL=sqlite+aiosqlite:///./.radar_data/sessions.db
MEMORY_DB_PATH=./.radar_data/memory.db
VECTOR_DB_PATH=./.radar_data/signal_vectors.db

# --- Guardrails, Compaction & Observability ---
OFFLINE_FIXTURE_FALLBACK=true
ENABLE_CLOUD_DLP=false
ENABLE_CLOUD_TRACE=false
MODEL_ARMOR_TEMPLATE_ID=
MAX_PROMPT_TOKENS=16000
LOG_LEVEL=INFO
